footer{text-align:center;color:var(--muted);font-size:12px;padding:20px}
@media(max-width:520px){.card{padding:16px}.numbers{grid-template-columns:repeat(5,1fr)}#question{font-size:19px}.hero{padding:20px}}
</style>
</head>
<body>
<div class="wrap">
<header class="hero">
  <div>🏆 SIMULASI LOMBA • TINGKAT SMP</div>
  <h1> CERDAS CERMAT SMP </h1>
  <p>100 soal pilihan ganda • 9 bidang pengetahuan • Penilaian otomatis</p>
  <div class="stats">
    <div class="stat"><b>100</b><span>Soal</span></div>
    <div class="stat"><b>9</b><span>Kategori</span></div>
    <div class="stat"><b>100</b><span>Nilai maksimal</span></div>
  </div>
</header>

<section class="card" id="setup">
  <h2>Mulai Latihan</h2>
  <label for="student">Nama peserta</label><input id="student" placeholder="Masukkan nama peserta">
  <label for="team">Regu</label>
  <select id="team"><option>Regu A</option><option>Regu B</option><option>Regu C</option></select>
  <label for="category">Kategori soal</label>
  <select id="category"><option value="Semua">Semua kategori (100 soal)</option></select>
  <label for="order">Urutan soal</label>
  <select id="order"><option value="normal">Berurutan</option><option value="random">Acak</option></select>
  <p style="color:#64748b;font-size:14px">Setiap jawaban benar bernilai 1 poin. Nilai akhir dikonversi ke skala 100.</p>
  <button class="green" id="start">▶ Mulai Latihan</button>
</section>

<section class="card hidden" id="quiz">
  <div class="row"><strong id="participant"></strong><span class="tag" id="counter"></span></div>
  <div class="progress"><div class="bar" id="bar"></div></div>
  <div class="meta"><span class="tag" id="cat"></span><span id="answered"></span></div>
  <h2 id="question"></h2>
  <div id="options"></div>
  <div id="feedback" class="feedback hidden"></div>
  <div class="row" style="margin-top:18px">
    <button class="secondary" id="prev">← Sebelumnya</button>
    <button class="secondary" id="explain">Pembahasan</button>
    <button id="next">Berikutnya →</button>
  </div>
  <div class="row" style="margin-top:18px"><strong>Navigasi soal</strong><span style="font-size:13px;color:#64748b">Hijau = sudah dijawab</span></div>
  <div class="numbers" id="numbers"></div>
  <button class="green" id="finish" style="width:100%;margin-top:20px">Selesaikan dan Lihat Nilai</button>
</section>

<section class="card hidden" id="result">
  <div class="result">
    <div style="font-size:42px">🏅</div><h2>HASIL LATIHAN</h2>
    <div id="resultName"></div><div class="score" id="score"></div>
    <strong id="remark"></strong><p id="summary" style="color:#64748b"></p>
  </div>
  <div class="row">
    <h2>Pembahasan Jawaban</h2><button class="secondary" onclick="window.print()">Cetak Hasil</button>
  </div>
  <div id="review"></div>
  <button class="green" id="again" style="width:100%;margin-top:16px">↻ Kembali ke Menu</button>
</section>
<footer>Aplikasi latihan Cerdas Cermat SMP • Dapat dijalankan secara offline di browser.</footer>
</div>
