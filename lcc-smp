const categories = [...new Set(BANK.map(q=>q.category))];
const categorySelect = document.getElementById('category');
categories.forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;categorySelect.appendChild(o)});
let quiz=[], answers={}, current=0, student='', team='';
const $ = id => document.getElementById(id);
function shuffle(a){for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
$('start').onclick=()=>{
 student=$('student').value.trim()||'Peserta';team=$('team').value;
 let cat=$('category').value;
 quiz=BANK.filter(q=>cat==='Semua'||q.category===cat).map(q=>({...q}));
 if($('order').value==='random')shuffle(quiz);
 answers={};current=0;
 $('setup').classList.add('hidden');$('result').classList.add('hidden');$('quiz').classList.remove('hidden');
 $('participant').textContent=student+' • '+team;render();
};
function render(){
 const q=quiz[current];
 $('counter').textContent=`Soal ${current+1} dari ${quiz.length}`;
 $('bar').style.width=((current+1)/quiz.length*100)+'%';
 $('cat').textContent=q.category;
 $('answered').textContent=Object.keys(answers).length+' dijawab';
 $('question').textContent=(current+1)+'. '+q.question;
 $('options').innerHTML='';
 q.options.forEach((op,i)=>{
  const label=document.createElement('label');label.className='option'+(answers[current]===i?' selected':'');
  const radio=document.createElement('input');radio.type='radio';radio.name='answer';radio.checked=answers[current]===i;
  radio.onchange=()=>{answers[current]=i;render()};
  const span=document.createElement('span');span.textContent=String.fromCharCode(65+i)+'. '+op;
  label.append(radio,span);$('options').append(label);
 });
 $('feedback').classList.add('hidden');$('prev').disabled=current===0;$('next').disabled=current===quiz.length-1;
 $('numbers').innerHTML='';
 quiz.forEach((_,i)=>{const b=document.createElement('button');b.textContent=i+1;b.className=(answers[i]!==undefined?'done ':'')+(i===current?'current':'');b.onclick=()=>{current=i;render()};$('numbers').append(b)});
}
$('prev').onclick=()=>{if(current>0){current--;render()}};
$('next').onclick=()=>{if(current<quiz.length-1){current++;render()}};
$('explain').onclick=()=>{
 const q=quiz[current],f=$('feedback');f.classList.remove('hidden');
 const chosen=answers[current];
 f.innerHTML='';
 const title=document.createElement('strong');title.className=chosen===q.answer?'correct':'wrong';
 title.textContent=chosen===q.answer?'Jawaban benar!':chosen===undefined?'Soal belum dijawab.':'Jawaban belum tepat.';
 const key=document.createElement('div');key.textContent='Kunci: '+String.fromCharCode(65+q.answer)+'. '+q.options[q.answer];
 const exp=document.createElement('div');exp.textContent=q.explanation;
 f.append(title,key,exp);
};
$('finish').onclick=()=>{
 const correct=quiz.filter((q,i)=>answers[i]===q.answer).length;
 const score=Math.round(correct/quiz.length*100);
 $('quiz').classList.add('hidden');$('result').classList.remove('hidden');
 $('resultName').textContent=student+' • '+team;
 $('score').textContent=score+'/100';
 $('remark').textContent=score>=85?'Luar biasa!':score>=70?'Bagus!':score>=50?'Terus berlatih!':'Jangan menyerah, terus belajar!';
 $('summary').textContent=`${correct} benar • ${quiz.length-correct} salah atau belum dijawab • ${quiz.length} soal`;
 $('review').innerHTML='';
 quiz.forEach((q,i)=>{
  const d=document.createElement('div');d.className='review-item';
  const h=document.createElement('strong');h.textContent=`${i+1}. ${q.question}`;
  const status=document.createElement('div');status.className=answers[i]===q.answer?'correct':'wrong';
  status.textContent=answers[i]===q.answer?'✓ Benar':answers[i]===undefined?'Belum dijawab':'✗ Salah';
  const key=document.createElement('div');key.textContent='Kunci: '+String.fromCharCode(65+q.answer)+'. '+q.options[q.answer];
  const exp=document.createElement('small');exp.textContent=q.explanation;
  d.append(h,status,key,exp);$('review').append(d);
 });
};
$('again').onclick=()=>{$('result').classList.add('hidden');$('setup').classList.remove('hidden')};
</script>
