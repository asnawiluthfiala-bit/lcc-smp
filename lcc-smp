<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aplikasi Cerdas Cermat SMP - 100 Soal</title>
<style>
:root{--navy:#173d70;--blue:#2563eb;--green:#16834a;--bg:#f3f6fb;--ink:#172033;--muted:#64748b}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:Arial,Helvetica,sans-serif;color:var(--ink)}
.wrap{max-width:850px;margin:28px auto;padding:0 16px}.hero{background:linear-gradient(135deg,#173d70,#2563eb);color:white;border-radius:20px;padding:26px;box-shadow:0 10px 25px #173d7022}
.hero h1{margin:8px 0;font-size:clamp(25px,5vw,38px)}.hero p{margin:6px 0;color:#e2eaff}
.stats{display:flex;gap:12px;margin-top:20px;flex-wrap:wrap}.stat{background:#ffffff20;border:1px solid #ffffff30;padding:12px 16px;border-radius:12px;min-width:110px}.stat b{display:block;font-size:23px}
.card{background:white;border-radius:16px;padding:22px;margin-top:18px;box-shadow:0 4px 18px #1720330c}
label{font-weight:700;display:block;margin:12px 0 7px}input,select{width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:9px;font-size:16px;background:white}
button{border:0;border-radius:10px;padding:12px 17px;background:var(--blue);color:white;font-weight:700;font-size:15px;cursor:pointer}button:hover{filter:brightness(.95)}button:disabled{opacity:.4;cursor:not-allowed}.secondary{background:#e8eef8;color:#173d70}.green{background:var(--green)}.row{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.hidden{display:none!important}.progress{height:9px;background:#e5eaf2;border-radius:20px;overflow:hidden;margin:14px 0}.bar{height:100%;background:#16834a;width:0;transition:.2s}
.meta{display:flex;justify-content:space-between;gap:10px;align-items:center;color:var(--muted);font-size:14px}.tag{background:#e8f0ff;color:#1d4ed8;padding:6px 10px;border-radius:20px;font-weight:700;font-size:12px}
#question{font-size:22px;line-height:1.4;margin:22px 0}.option{display:flex;gap:12px;align-items:center;border:1px solid #dbe2ec;padding:13px;border-radius:11px;margin:9px 0;cursor:pointer;line-height:1.35}.option:hover{border-color:#2563eb;background:#f7faff}.option input{width:auto;accent-color:#2563eb}.option.selected{border-color:#2563eb;background:#eff6ff}
.numbers{display:grid;grid-template-columns:repeat(10,1fr);gap:6px;margin-top:12px}.numbers button{padding:8px 2px;background:#e8eef8;color:#334155;font-size:13px}.numbers button.done{background:#16834a;color:white}.numbers button.current{outline:3px solid #93c5fd}
.feedback{padding:14px;border-radius:10px;background:#f1f5f9;margin-top:14px;line-height:1.5}.correct{color:#16834a}.wrong{color:#dc2626}
